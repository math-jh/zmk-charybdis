#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/behaviors.h>
#include <dt-bindings/zmk/rgb.h>


&lt {
    tapping-term-ms = <200>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

/ {
    scroll_encoder: scroll_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

        tap-ms = <100>;
    };

    macros {
        leader: snippet_leader {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            tap-ms = <1>;
            wait-ms = <1>;
            bindings = <&macro_tap &kp LC(LG(LA(SPACE))) &kp LC(LG(LS(RBKT)))>;
        };
        leader_alt: snippet_leader_alternative {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            tap-ms = <1>;
            wait-ms = <1>;
            bindings = <&macro_tap &kp LC(LG(LA(SPACE))) &kp LC(LG(LS(LA(RBKT))))>;
        };
    };

    combos {
        compatible = "zmk,combos";
        combo_enter {
            timeout-ms = <200>;
            key-positions = <56 60>;
            bindings = <&kp ENTER>;
        };
        combo_leader_alternative {
            timeout-ms = <200>;
            key-positions = <57 59>;
            bindings = <&leader_alt>;
        };
        combo_vivaldi {
            timeout-ms = <150>;
            key-positions = <62 63>;
            bindings = <&kp LG(LALT)>;
        };
        combo_left_rectangle {
            timeout-ms = <150>;
            key-positions = <53 54>;
            bindings = <&kp LC(LALT)>;
        };
        combo_lbkt {
            timeout-ms = <150>;
            key-positions = <9 10>;
            bindings = <&kp LBKT>;
        };
        combo_win {
            timeout-ms = <150>;
            key-positions = <53 63>;
            bindings = <&tog_on 2>;
            layers = <0>;
        };
        combo_mac {
            timeout-ms = <150>;
            key-positions = <53 63>;
            bindings = <&tog_off 2>;
            layers = <2>;
        };
    };

    behaviors {
        as: auto_shift {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping_term_ms = <275>;
            quick_tap_ms = <0>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        mta: mod_tap_alternative {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping_term_ms = <250>;
            quick_tap_ms = <0>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        lts: layer_tap_sticky {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            bindings = <&kp>, <&slq>;
            display-name = "Layer-Tap";
        };

        slq: sticky_layer_non_quick_release {
            compatible = "zmk,behavior-sticky-key";
            #binding-cells = <1>;
            bindings = <&mo>;
            release-after-ms = <1000>;
            ignore-modifiers;
          };

        gtesc: grave_tilde_escape {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp ESC>, <&kp GRAVE>;
            mods = <(MOD_LGUI|MOD_LALT|MOD_LSFT|MOD_RGUI|MOD_RALT|MOD_RSFT)>;
            keep-mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        bspc_del: backspace_delete {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp BACKSPACE>, <&kp DELETE>;
            mods = <(MOD_LALT|MOD_LSFT|MOD_RALT|MOD_RSFT)>;
        };

        tog_on: toggle_layer_on_only {
            compatible = "zmk,behavior-toggle-layer";
            #binding-cells = <1>;
            display-name = "Toggle Layer On";
            toggle-mode = "on";
        };

        tog_off: toggle_layer_off_only {
            compatible = "zmk,behavior-toggle-layer";
            #binding-cells = <1>;
            display-name = "Toggle Layer Off";
            toggle-mode = "off";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Base {
            bindings = <
&gtesc          &kp N1   &kp N2   &kp N3     &kp N4       &kp N5      &kp N6      &kp N7      &kp N8      &kp N9    &kp N0     &kp MINUS
&kp TAB         &kp Q    &kp W    &kp E      &kp R        &kp T       &kp Y       &kp U       &kp I       &kp O     &kp P      &kp BSLH
&mta CAPS RALT  &kp A    &kp S    &kp D      &kp F        &kp G       &kp H       &kp J       &kp K       &kp L     &kp SEMI   &kp APOS
&lts LSFT 2     &kp Z    &kp X    &kp C      &kp V        &kp B       &kp N       &kp M       &kp COMMA   &kp DOT   &kp FSLH   &mt RSHFT ENTER
                                  &kp SPACE  &lt 4 LGUI   &bspc_del   &leader     &kp SPACE
                                             &lt 3 LALT   &kp LCTL    &lt 1 RCTL  
            >;
        };

        Fn {
            bindings = <
&kp C_BRI_DEC  &kp C_BRI_DEC  &kp LC(UP)  &kp LG(SPACE)      &kp LG(LS(N4))  &kp LG(LS(N5))  &kp C_PREV         &kp C_PP           &kp C_NEXT  &kp C_MUTE  &kp C_VOL_DN    &kp C_VOL_UP
&trans         &bt BT_NXT     &bt BT_CLR  &trans             &trans          &trans          &trans             &trans             &trans      &trans      &trans          &trans
&trans         &trans         &trans      &trans             &trans          &trans          &trans             &kp LC(LG(LA(J)))  &trans      &trans      &trans          &trans
&trans         &trans         &trans      &kp LC(LG(LA(C)))  &trans          &trans          &kp LC(LG(LA(N)))  &trans             &trans      &trans      &trans          &trans
                                          &trans             &trans          &trans          &trans             &trans
                                                             &trans          &to 0           &trans
            >;
        };

        Symbol {
            bindings = <
&trans     &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp LBKT  &kp RBKT  &kp EQUAL
&trans     &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans    &trans
&trans     &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans    &trans
&kp LSHFT  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans    &trans
                           &trans  &trans  &trans  &trans  &trans
                                   &trans  &trans  &trans
            >;
        };

        scroll-layers {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans    &trans  &trans
                                &trans  &to 0     &trans
            >;
        };

        snipe-layers {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans     &trans     &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans     &trans     &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &mkp LCLK  &mkp RCLK  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans     &trans     &trans  &trans  &trans  &trans
                        &trans  &trans  &trans    &mkp LCLK  &mkp RCLK
                                &trans  &to 0     &trans
            >;
        };
    };
};
