#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/behaviors.h>
#include <dt-bindings/zmk/rgb.h>


&lt {
    tapping-term-ms = <200>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

/ {
    scroll_encoder: scroll_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

        tap-ms = <100>;
    };

    macros {
        leader: snippet_leader {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            tap-ms = <1>;
            wait-ms = <1>;
            bindings = <&macro_tap &kp LC(LG(LA(SPACE))) &kp LC(LG(LS(RBKT)))>;
        };
        leader_alt: snippet_leader_alternative {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            tap-ms = <1>;
            wait-ms = <1>;
            bindings = <&macro_tap &kp LC(LG(LA(SPACE))) &kp LC(LG(LS(LA(RBKT))))>;
        };
    };

    combos {
        compatible = "zmk,combos";
        combo_enter {
            timeout-ms = <200>;
            key-positions = <48 52>;
            bindings = <&kp ENTER>;
        };
        combo_leader_alternative {
            timeout-ms = <200>;
            key-positions = <54 55>;
            bindings = <&leader_alt>;
        };
        combo_vivaldi_right {
            timeout-ms = <150>;
            key-positions = <51 52>;
            bindings = <&kp LG(LALT)>;
        };
        combo_rectangle_right {
            timeout-ms = <150>;
            key-positions = <51 54>;
            bindings = <&kp LC(LALT)>;
        };
        combo_lbkt {
            timeout-ms = <150>;
            key-positions = <8 9>;
            bindings = <&kp LBKT>;
        };
    };

    behaviors {
        as: auto_shift {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping_term_ms = <275>;
            quick_tap_ms = <0>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        mta: mod_tap_alternative {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping_term_ms = <250>;
            quick_tap_ms = <0>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        lt: layer_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&mo>, <&kp>;
            display-name = "Layer-Tap";
        };

        lta: layer_tap_alternative {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            bindings = <&mo>, <&kp>;
            display-name = "Layer-Tap";
        };

        lts: layer_tap_sticky {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            bindings = <&kp>, <&slq>;
            display-name = "Layer-Tap-sticky";
        };

        slq: sticky_layer_non_quick_release {
            compatible = "zmk,behavior-sticky-key";
            #binding-cells = <1>;
            bindings = <&mo>;
            release-after-ms = <1000>;
            ignore-modifiers;
          };

        gtesc: grave_tilde_escape {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp ESC>, <&kp GRAVE>;
            mods = <(MOD_LGUI|MOD_LALT|MOD_LSFT|MOD_RGUI|MOD_RALT|MOD_RSFT)>;
            keep-mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        bspc_del: backspace_delete {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp BACKSPACE>, <&kp DELETE>;
            mods = <(MOD_LALT|MOD_LSFT|MOD_RALT|MOD_RSFT)>;
        };

        tog_on: toggle_layer_on_only {
            compatible = "zmk,behavior-toggle-layer";
            #binding-cells = <1>;
            display-name = "Toggle Layer On";
            toggle-mode = "on";
        };

        tog_off: toggle_layer_off_only {
            compatible = "zmk,behavior-toggle-layer";
            #binding-cells = <1>;
            display-name = "Toggle Layer Off";
            toggle-mode = "off";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Base {
            bindings = <
&gtesc          &kp N1   &kp N2   &kp N3     &kp N4    &kp N5     &kp N6   &kp N7      &kp N8      &kp N9    &kp N0     &kp MINUS
&kp TAB         &kp Q    &kp W    &kp E      &kp R     &kp T      &kp Y    &kp U       &kp I       &kp O     &kp P      &kp BSLH
&mta CAPS RALT  &kp A    &kp S    &kp D      &kp F     &kp G      &kp H    &kp J       &kp K       &kp L     &kp SEMI   &kp APOS
&lts LSFT 2     &kp Z    &kp X    &kp C      &kp V     &kp B      &kp N    &kp M       &kp COMMA   &kp DOT   &kp FSLH   &lta 3 ENTER
                                  &kp SPACE  &kp LALT  &kp LGUI   &mo 1    &kp SPACE
                                             &kp LCTL  &bspc_del  &leader  
            >;
        };

        Fn {
            bindings = <
&kp C_BRI_DEC  &kp C_BRI_DEC  &kp LC(UP)  &kp LG(SPACE)      &kp LG(LS(N4))  &kp LG(LS(N5))  &kp C_PREV         &kp C_PP           &kp C_NEXT  &kp C_MUTE  &kp C_VOL_DN    &kp C_VOL_UP
&trans         &bt BT_NXT     &bt BT_CLR  &trans             &trans          &trans          &trans             &trans             &trans      &trans      &trans          &trans
&trans         &trans         &trans      &trans             &trans          &trans          &trans             &kp LC(LG(LA(J)))  &trans      &trans      &trans          &trans
&trans         &trans         &trans      &kp LC(LG(LA(C)))  &trans          &trans          &kp LC(LG(LA(N)))  &trans             &trans      &trans      &trans          &trans
                                          &trans             &trans          &trans          &trans             &trans
                                                             &trans          &to 0           &trans
            >;
        };

        Symbol {
            bindings = <
&trans     &trans    &trans    &trans     &trans  &trans  &trans  &trans  &trans     &kp LBKT   &kp RBKT  &kp EQUAL
&trans     &trans    &kp UP    &trans     &trans  &trans  &trans  &trans  &trans     &trans     &trans    &trans
&trans     &kp LEFT  &kp DOWN  &kp RIGHT  &trans  &trans  &trans  &trans  &trans     &mkp RCLK  &trans    &trans
&kp LSHFT  &trans    &trans    &trans     &trans  &trans  &trans  &trans  &mkp LCLK  &trans     &trans    &trans
                               &trans     &trans  &trans  &trans  &trans
                                          &trans  &to 0   &trans
            >;
        };

        snipe-layers {
            bindings = <
&trans  &trans    &trans    &trans     &trans  &trans  &trans  &trans  &trans     &trans     &trans  &trans
&trans  &trans    &kp UP    &trans     &trans  &trans  &trans  &trans  &trans     &trans     &trans  &trans
&trans  &kp LEFT  &kp DOWN  &kp RIGHT  &trans  &trans  &trans  &trans  &trans     &mkp RCLK  &trans  &trans
&mo 4   &trans    &trans    &trans     &trans  &trans  &trans  &trans  &mkp LCLK  &trans     &trans  &trans
                            &trans     &trans  &trans  &trans  &trans
                                       &trans  &to 0   &trans
            >;
        };

        scroll-layers {
            bindings = <
&trans  &trans    &trans    &trans     &trans  &trans  &trans  &trans  &trans     &trans     &trans     &trans
&trans  &trans    &kp UP    &trans     &trans  &trans  &trans  &trans  &trans     &trans     &trans     &trans
&trans  &kp LEFT  &kp DOWN  &kp RIGHT  &trans  &trans  &trans  &trans  &trans     &mkp RCLK  &trans     &trans
&trans  &trans    &trans    &trans     &trans  &trans  &trans  &trans  &mkp LCLK  &trans     &kp QMARK  &trans
                            &trans     &trans  &trans  &trans  &trans
                                       &trans  &to 0   &trans
            >;
        };
    };
};
